#carousel-canvas {
    width: 100%;
    height: 100%;
    display: block;
}

.project-description {
    font-family: Metropolis;
    font-weight: 900;
    position: absolute;
    bottom: 240px;
    left: 50%;
    transform: translateX(-50%);
    text-align: center;
    color: #0a0a0a;
    z-index: 10;
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
}

.project-description.active {
    opacity: 1;
}

.project-description p {
    font-size: 14px;
    font-weight: 800;
    margin: 0;
    opacity: 0.7;
    text-transform: uppercase;
    letter-spacing: 1px;
}

.project-title {
    position: absolute;
    bottom: 80px;
    left: 50%;
    transform: translateX(-50%);
    text-align: center;
    color: #0a0a0a;
    z-index: 10;
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
}

.project-title.active {
    opacity: 1;
}

.project-title h2 {
    font-size: 48px;
    font-weight: 800;
    margin: 0 0 8px 0;
    letter-spacing: 0.5px;
}

.project-title p {
    font-size: 16px;
    font-weight: 400;
    margin: 0;
    opacity: 0.7;
}

.scroll-indicator {
    font-family: Metropolis;
    position: absolute;
    bottom: 24px;
    left: 50%;
    transform: translateX(-50%);
    text-align: center;
    color: rgba(0, 0, 0, 0.5);
}

.scroll-indicator p {
    font-size: 10px;
    font-weight: 300;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin: 0;
}

.scroll-indicator .mobile-text {
    display: none;
}

/* Mobile Styles */
@media (max-width: 968px) {
    body, html {
        overflow: hidden;
        height: 100vh;
    }
    
    .work-hero {
        height: 100vh;
        overflow: hidden;
    }
    
    #carousel-canvas {
        touch-action: pan-x;
        cursor: grab;
    }
    
    #carousel-canvas:active {
        cursor: grabbing;
    }
    
    .project-description {
        bottom: 150px;
        padding: 0 20px;
        width: calc(100% - 40px);
    }
    
    .project-description p {
        font-size: 11px;
    }
    
    .project-title {
        bottom: 50px;
        padding: 0 20px;
        width: calc(100% - 40px);
    }
    
    .project-titl40px;
        padding: 0 16px;
        width: calc(100% - 32px);
    }
    
    .project-description p {
        font-size: 10px;
    }
    
    .project-title {
        bottom: 45px;
        padding: 0 16px;
        width: calc(100% - 32px);
    }
    
    .project-title h2 {
        font-size: 22px;
    }
    
    .project-title p {
        font-size: 11px;
    }
    
    .scroll-indicator {
        bottom: 14px;
    }
    
    .scroll-indicator p {
        font-size: 7
        bottom: 50px;
        padding: 0 16px;
        width: calc(100% - 32px);
    }
    
    .project-title h2 {
        font-size: 24px;
    }
    
    .project-title p {
        font-size: 12px;
    }
    
    .scroll-indicator {
        bottom: 16px;
    }
        .scroll-indicator .desktop-text {
        display: none;
    }
    
    .scroll-indicator .mobile-text {
        display: block;
    }
        .scroll-indicator p {
        font-size: 8px;
    }
}
